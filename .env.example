OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=

# AI models used to write the news (optional; defaults shown).
# If Groq or Ollama retires a model, change it here, no code change needed.
# Groq models your key can use: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen3:8b
